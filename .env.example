# RecoverAI environment configuration
# Copy this file to .env for local setup. NEVER commit the real .env.

# Database (SQLite — zero setup). For PostgreSQL: provider "postgresql" + postgres URL.
DATABASE_URL="file:./dev.db"

# AI provider: mock | gemini | deepseek
AI_PROVIDER=mock

# Provider API keys (server-side only — never exposed to the browser)
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# AI request timeout in milliseconds
AI_TIMEOUT_MS=8000

# Simulated Razorpay credentials (integration layer is simulated in demo mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
